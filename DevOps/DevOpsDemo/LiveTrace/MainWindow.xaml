<Window x:Class="LiveTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AS Live Trace" Height="700" Width="1050" MinHeight="500" MinWidth="800"
        Closing="Window_Closing">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
      <TextBlock Text="PLC IP" VerticalAlignment="Center" />
      <TextBox x:Name="PlcIpTextBox" Text="127.0.0.1" Width="130" Margin="8,0,16,0" />
      <TextBlock Text="Task" VerticalAlignment="Center" />
      <TextBox x:Name="TaskTextBox" Text="Main" Width="120" Margin="8,0,16,0" />
      <TextBlock Text="Refresh (ms)" VerticalAlignment="Center" />
      <TextBox x:Name="RefreshTextBox" Text="200" Width="60" Margin="8,0,16,0" />
      <TextBlock Text="Variables (comma-separated)" VerticalAlignment="Center" />
      <TextBox x:Name="VariablesTextBox" Text="em.StateCurrent" Width="250" Margin="8,0,0,0" />
    </WrapPanel>
    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="StatusTextBlock" Text="Ready" Margin="0,0,0,8" />
    <Button Grid.Row="1" Grid.Column="1" x:Name="ToggleButton" Content="Start trace" Padding="16,4" Click="ToggleButton_Click" Margin="8,0,0,8" />

    <DataGrid Grid.Row="2" Grid.ColumnSpan="2" x:Name="ValuesGrid" AutoGenerateColumns="False"
              IsReadOnly="True" SelectionChanged="ValuesGrid_SelectionChanged" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Variable" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        <DataGridTextColumn Header="Updated" Binding="{Binding Updated, StringFormat={}{0:HH:mm:ss.fff}}" Width="180" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="1" Margin="0,12,0,8">
      <Canvas x:Name="ChartCanvas" Background="#101820" SizeChanged="ChartCanvas_SizeChanged" />
    </Border>
    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Select a numeric variable to graph. The trace keeps the latest 600 samples per variable." />
  </Grid>
</Window>
