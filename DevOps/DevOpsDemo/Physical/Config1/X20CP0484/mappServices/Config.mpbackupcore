<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<Configuration>
  <Element ID="gBackupCore" Type="mpbackupcore">
    <Group ID="mapp.Gen">
      <Property ID="Enable" Value="TRUE" />
      <Property ID="EnableCockpit" Value="FALSE" />
      <Property ID="Audit" Value="FALSE" />
      <Property ID="Parent" />
    </Group>
    <Group ID="Backup">
      <Selector ID="AutomaticBackup" Value="Disabled" />
      <Selector ID="AutomaticUpdate" Value="Notify">
        <Property ID="DeviceName" Value="UPDATE" />
        <Selector ID="Check" Value="OnEnable" />
      </Selector>
    </Group>
    <Selector ID="Alarms" Value="None" />
  </Element>
</Configuration>