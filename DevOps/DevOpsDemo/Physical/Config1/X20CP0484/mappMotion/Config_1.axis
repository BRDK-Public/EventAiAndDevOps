<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<Configuration>
  <Element ID="gAxis_Conveyor" Type="axis">
    <Selector ID="BaseType" Value="Linear" />
  </Element>
  <Element ID="gAxis_Capper" Type="axis">
    <Selector ID="MovementLimits">
      <Selector ID="Velocity">
        <Property ID="Velocity" Value="3000" />
      </Selector>
    </Selector>
  </Element>
</Configuration>